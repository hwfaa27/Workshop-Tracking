# GEMINI_API_KEY: Required for server-side Gemini API calls (if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where WorkshopTrack is hosted (e.g. https://workshoptrack.vercel.app)
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# OPSI 1 — Database Connection URL (Direkomendasikan untuk Vercel / Supabase / Neon)
# Salin Connection String PostgreSQL (Transaction/Session Pooler port 6543 atau 5432)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.project_ref:your_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

# ---------------------------------------------------------------------------
# OPSI 2 — Variabel Database Terpisah (Cloud SQL / PostgreSQL Standar)
# Digunakan apabila DATABASE_URL tidak diatur
# ---------------------------------------------------------------------------
SQL_HOST="db.example.supabase.co"
SQL_PORT="5432"
SQL_DB_NAME="postgres"
SQL_USER="postgres"
SQL_PASSWORD="your_db_password"
SQL_SSL="true"

# Cloud SQL Schema Migration Variables (Used by Drizzle Kit)
SQL_ADMIN_USER="admin_user"
SQL_ADMIN_PASSWORD="admin_password"

# ---------------------------------------------------------------------------
# Firebase Authentication (Frontend & Backend Token Verification)
# Pastikan FIREBASE_PROJECT_ID dan VITE_FIREBASE_PROJECT_ID bernilai sama!
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID="infra-vertex-z5v9p"
VITE_FIREBASE_PROJECT_ID="infra-vertex-z5v9p"
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="infra-vertex-z5v9p.firebaseapp.com"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
VITE_FIREBASE_STORAGE_BUCKET="infra-vertex-z5v9p.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
