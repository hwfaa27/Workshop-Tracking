# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL Runtime Environment Variables (Automatically injected by platform)
SQL_HOST="/cloudsql/instance-connection-path"
SQL_DB_NAME="postgres"
SQL_USER="app_user"
SQL_PASSWORD="app_password"

# Cloud SQL Schema Migration Variables (Used by Drizzle Kit)
SQL_ADMIN_USER="admin_user"
SQL_ADMIN_PASSWORD="admin_password"
